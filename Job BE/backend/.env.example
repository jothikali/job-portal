# Server
PORT=5000

# Database (Aiven / PlanetScale / Railway / local MySQL)
DB_HOST=your-db-host.example.com
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=job_portal_db
DB_SSL=true   # set to true for cloud DBs like Aiven

# Frontend URL (set this in Render dashboard — your Vercel deployment URL)
# Used by CORS to allow requests from your frontend
FRONTEND_URL=https://your-app.vercel.app
